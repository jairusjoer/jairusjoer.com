---
import { type Props as ItemProps } from '@components/Item.astro';
import Icon from './Icon.astro';
import Item from './Item.astro';

export interface Props extends ItemProps {
  icon: string;
  highlights?: string[];
  items?: ItemProps[];
}

const props = Astro.props;
---

<li class="relative break-inside-avoid space-y-3">
  <header class="flex w-full gap-3">
    <div class="bg-background-subtle grid size-12 shrink-0 place-items-center rounded-lg print:border">
      <Icon name={props.icon} />
    </div>
    <Item {...props} />
  </header>

  {
    props.highlights && (
      <ul
        class:list={[
          'relative list-disc space-y-3 pl-15',
          {
            'before:border-border before:absolute before:-top-6 before:-bottom-3 before:left-6 before:border-l':
              props.items,
          },
        ]}
      >
        {props.highlights.map((highlight) => (
          <li>{highlight}</li>
        ))}
      </ul>
    )
  }
  {
    props.items && (
      <ul class="space-y-3 overflow-hidden pl-15">
        {props.items.map((item) => (
          <li
            class:list={[
              'relative',
              'before:border-border before:absolute before:-top-45 before:-left-9 before:-z-10 before:block before:h-48 before:w-6 before:rounded-bl-xl before:border-b before:border-l',
            ]}
          >
            <Item {...item} />
          </li>
        ))}
      </ul>
    )
  }
</li>
