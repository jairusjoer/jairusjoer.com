---
export interface Props {
  name: string;
  class?: string;
}

const props = Astro.props;
const [type, name] = props.name.split(':');

let Element;

switch (type) {
  case 'local':
    Element = (await import(`../assets/icons/${name}.svg`)).default;
    break;

  case 'lucide':
    Element = (await import(`@lucide/vue/dist/esm/icons/${name}.mjs`)).default;
    break;
}
---

<Element
  class:list={['inline-block size-4 align-middle', props.class]}
  aria-hidden
/>
