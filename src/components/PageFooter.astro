---
import type { PageConfigLink } from '../page.config';
import PageNavigation from './PageNavigation.astro';

export interface Props {
  links?: PageConfigLink[];
}

const { links } = Astro.props;
---

{
  links?.length && (
    <footer class="print-hidden mt-auto">
      <PageNavigation links={links} />
    </footer>
  )
}
