---
import { Image } from 'astro:assets';
import { page } from '../page.config';
---

<header>
  <a href="/">
    {
      page?.image && (
        <Image
          class="mb-6 size-12 rounded-lg"
          src={await page.image()}
          alt=""
          width={144}
          height={144}
        />
      )
    }
    <div>
      <p class="text-foreground font-medium">{page.title}</p>
      <p>{page.description}</p>
    </div>
  </a>
</header>
