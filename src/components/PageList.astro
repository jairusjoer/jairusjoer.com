---
import Item from '@components/Item.astro';
import { formatDateTime } from '@scripts/formatDateTime';
import { isPublished } from '@scripts/isPublished';
import { getCollection } from 'astro:content';

export interface Props {
  filter?: string;
}

const { filter } = Astro.props;

let collection = await getCollection('pages', ({ id }) => {
  if (id.endsWith('index')) return false;

  return filter ? id.startsWith(filter.toLowerCase()) : true;
});

collection = collection.sort((a, b) => {
  const dateA = a.data.date?.getTime() ?? 0;
  const dateB = b.data.date?.getTime() ?? 0;

  return dateB - dateA;
});

if (import.meta.env.PROD) {
  collection = collection.filter((entry) => isPublished(entry.data?.status));
}
---

<ul class="space-y-3">
  {
    collection.map((entry) => (
      <li>
        <Item
          href={`/${entry.id}`}
          text={[
            [entry.data.status, entry.data.title].filter(Boolean).join(': '),
            entry.data.date && formatDateTime(entry.data.date),
          ]}
        />
      </li>
    ))
  }
</ul>
