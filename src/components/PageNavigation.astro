---
import type { PageConfigLink } from '../page.config.ts';

export interface Props {
  class?: string;
  links?: PageConfigLink[];
}

const { class: className, links } = Astro.props;

const active = (path: string) => {
  if (path === '/') {
    return Astro.url.pathname === path;
  } else {
    return Astro.url.pathname.startsWith(path);
  }
};
---

{
  links?.length && (
    <nav class:list={['w-full print:hidden', className]}>
      <ul class="flex flex-wrap items-center gap-6 font-medium">
        <slot />
        {links.map((link) => (
          <li>
            <a
              class={active(link.href) ? 'text-foreground underline' : 'ghost'}
              href={link.href}
            >
              {link.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
