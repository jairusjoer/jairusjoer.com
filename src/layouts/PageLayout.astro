---
import '@styles/global.css';
import PageFooter from '@components/PageFooter.astro';
import PageHeader from '@components/PageHeader.astro';
import PageMeta from '@components/PageMeta.astro';
import type { Metadata } from '@components/PageMeta.astro';
import { Font } from 'astro:assets';
import PageNavigation from '../components/PageNavigation.astro';
import { page } from '../page.config';

export interface Props {
  metadata?: Metadata;
}

const { metadata } = Astro.props;
---

<html
  lang={page.locale.slice(0, 2)}
  class="bg-background text-foreground-subtle text-pretty antialiased scheme-light-dark print:bg-transparent print:scheme-light"
>
  <head>
    <PageMeta {metadata} />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />
    <slot name="head" />
  </head>
  <body>
    <div
      id="root"
      class="text-default px-6 py-24 font-sans"
    >
      <div class="max-w-default mx-auto flex min-h-dvh w-full flex-col items-start print:ml-0 print:max-w-none">
        <PageHeader />
        <PageNavigation
          class="mt-6"
          links={page.navigation}
        />
        <slot />
        <PageFooter links={page.footer} />
      </div>
    </div>
  </body>
</html>
