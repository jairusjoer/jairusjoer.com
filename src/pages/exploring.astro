---
import DotMatrix from '@components/content/DotMatrix.astro';
import ThemeContrast from '@components/content/ThemeContrast.vue';
import ThemeControls from '@components/content/ThemeControls.vue';
import ThemePalette from '@components/content/ThemePalette.vue';
import type { Metadata } from '@components/PageMeta.astro';
import Section from '@components/Section.astro';
import Showcase from '@components/Showcase.vue';
import PageLayout from '@layouts/PageLayout.astro';

const metadata: Metadata = {
  title: 'Exploring',
  description: 'Experiments and other curiosities',
  id: 'exploring',
};
---

<PageLayout {metadata}>
  <main class="my-18 w-full space-y-6">
    <h1 class="text-foreground font-medium">{metadata.title}</h1>
    <p>{metadata.description}</p>

    <Section title="Theme Contrast & Palette">
      <div class="prose">
        <p>
          While writing the post <a href="/writing/demonstrating-software-personalisation"
            >Demonstrating Software Personalisation</a
          >, I built these interactive theme components to offer a more interactive and explorable approach to the
          topic.
        </p>
        <ThemeControls client:load />
        <ThemeContrast client:load />
        <ThemePalette client:load />
      </div>
    </Section>

    <Section title="Dot Matrix">
      <div class="prose">
        <p>
          I've come to like Bungie's Marathon and its art style, which was surely assisted by the involvement of{' '}
          <a href="https://www.kurppahosk.com/work/bungie">Kurppa Hosk</a>, a design favourite of mine. What you see
          here is a customisable approximation of the game's loading animation.
        </p>
        <Showcase
          links={{
            Usage: 'src/pages/exploring.astro?plain=1#L46-L104',
            Code: 'src/components/content/DotMatrix.astro',
          }}
        >
          <DotMatrix
            config={{
              grid: {
                columns: 17,
                rows: 17,
                width: 224,
